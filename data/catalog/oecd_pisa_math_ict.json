    {
      "id": "pisa_screen_time_paradox",
      "title": "The Digital Exposure Paradox in PISA: How Classroom Disciplinary Climate Buffers Excessive Screen Distraction",
      "focus_metrics": [
        "Math_Literacy_Score",
        "Classroom_Digital_Hours_Weekly",
        "Recreational_Screen_Hours_Daily",
        "Disciplinary_Climate_Index",
        "Math_Anxiety_Index"
      ],
      "research_questions": [
        "Does excessive recreational digital screen time correlate negatively with secondary mathematics literacy?",
        "Does a disciplined classroom learning climate buffer against digital distraction and mathematics anxiety?"
      ],
      "hypotheses": [
        "Recreational screen time exhibits a statistically significant negative coefficient on mathematics scores after controlling for instructional usage.",
        "Classroom disciplinary climate exerts a powerful positive moderating effect on mathematics achievement with low multicollinearity (VIF < 2.0)."
      ],
      "theoretical_framework": "Cognitive Load Theory (Sweller) and Educational Productivity Model (Walberg)"
    }
  ]
