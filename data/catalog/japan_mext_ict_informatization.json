        "Inquiry_Collaborative_Lesson_Pct",
        "Device_Maintenance_Hours_Weekly"
      ],
      "research_questions": [
        "To what extent does daily 1:1 device saturation predict authentic inquiry-based collaborative learning?",
        "Does technical device troubleshooting overhead crowd out pedagogical innovation in classroom instruction?"
      ],
      "hypotheses": [
        "Daily device utilization alone exhibits diminishing returns on deep inquiry-based lesson integration without dedicated teacher ICT support.",
        "Weekly device maintenance hours exert a statistically significant suppressive effect on pedagogical integration."
      ],
      "theoretical_framework": "TPACK Framework (Mishra & Koehler, 2006) and Substitution-Augmentation-Modification-Redefinition (SAMR) Model"
