# ==============================================================================
# OpenDataAnalysisTokouynu - Environment Variables Configuration
# Target WordPress Site: https://seda68.wordpress.com
# ==============================================================================

# Publishing Mode: 'wordpress_mail' (Recommended Default), 'wordpress_rest', or 'markdown_only'
BLOG_PUBLISHER_TYPE=wordpress_mail

# ------------------------------------------------------------------------------
# WordPress Post by Email Settings (Primary for seda68.wordpress.com)
# ------------------------------------------------------------------------------
# Secret email address provided by WordPress.com (WP Admin -> Settings -> Writing -> Post by Email)
WP_POST_EMAIL=secret_post_address@post.wordpress.com
WP_SITE_URL=https://seda68.wordpress.com

# SMTP credentials for sending emails (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password

# Post configuration
WP_POST_STATUS=publish
DEFAULT_CATEGORIES=Open Data Analysis,Educational Policy,Empirical Research

# ------------------------------------------------------------------------------
# AI Text Generation (Gemini API)
# ------------------------------------------------------------------------------
# Google Gemini API Key for English academic paper synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# (Optional) Anthropic Claude API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# ------------------------------------------------------------------------------
# WordPress REST API Settings (Alternative option)
# ------------------------------------------------------------------------------
WP_USER=
WP_APP_PASSWORD=

# ------------------------------------------------------------------------------
# Execution & Repository Defaults
# ------------------------------------------------------------------------------
DEFAULT_TOPIC=all
GITHUB_REPOSITORY=k518-2026/OpenDataAnalysisTokouynu
GITHUB_BRANCH=main
