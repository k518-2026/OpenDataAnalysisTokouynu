# ==============================================================================
# OpenDataAnalysisTokouynu - Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key for academic paper synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# (Optional) Anthropic Claude API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Publishing Mode: 'wordpress_rest' (Recommended), 'wordpress_mail', or 'markdown_only'
BLOG_PUBLISHER_TYPE=wordpress_rest

# ------------------------------------------------------------------------------
# WordPress REST API Settings (Recommended)
# ------------------------------------------------------------------------------
# Target WordPress site URL (e.g., https://kouynu.wordpress.com or your custom domain)
WP_SITE_URL=https://kouynu.wordpress.com
# WordPress Username
WP_USER=your_wordpress_username
# WordPress Application Password (generated from WP Admin -> Users -> Profile -> Application Passwords)
WP_APP_PASSWORD=your_application_password_here
WP_POST_STATUS=publish
DEFAULT_CATEGORIES=Open Data Analysis,Educational Policy,Empirical Research

# ------------------------------------------------------------------------------
# WordPress Post by Email Settings (Alternative via SMTP)
# ------------------------------------------------------------------------------
WP_POST_EMAIL=secret_post_address@post.wordpress.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password

# ------------------------------------------------------------------------------
# Execution & Repository Defaults
# ------------------------------------------------------------------------------
DEFAULT_TOPIC=all
GITHUB_REPOSITORY=k518-2026/OpenDataAnalysisTokouynu
GITHUB_BRANCH=main
